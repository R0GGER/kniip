<Window x:Class="Kniip.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kniip instellingen" Width="720" Height="630" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/AppIcon.ico">
    <Window.Resources>
        <!-- Inhoud van een tab erft anders de blauwe, vette tekst van de geselecteerde tabkop -->
        <Style x:Key="TabPage" TargetType="StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,0,0,4" />
        </Style>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1,8,1"
                                Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Top" Background="Transparent" />
                            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True" Padding="16,14">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Standaardinstellingen" Click="ResetDefaults_Click"
                    ToolTip="Instellingen, toolstijlen, werkbalk en laatst gebruikte mappen terugzetten; pas bij Opslaan worden ze bewaard" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Annuleren" IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource AccentButton}" Content="Opslaan" IsDefault="True" Click="Save_Click" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ResetStatus" Style="{StaticResource Hint}" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed"
                       Text="Standaardwaarden ingevuld; klik op Opslaan om ze te bewaren." />
        </DockPanel>

        <TabControl Style="{StaticResource SettingsTabs}" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Sneltoetsen">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Sneltoetsen" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <TextBlock Text="Rechthoek" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="SnipHotkeyButton" Tag="Snip" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toets in, bijvoorbeeld Print Screen" />
                        <Button Tag="Snip" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Venster" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="WindowHotkeyButton" Tag="Window" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toets in, bijvoorbeeld Alt + Print Screen" />
                        <Button Tag="Window" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (MP4)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="RecordHotkeyButton" Tag="Record" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toetscombinatie in" />
                        <Button Tag="Record" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (GIF)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="GifHotkeyButton" Tag="Gif" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toetscombinatie in" />
                        <Button Tag="Gif" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Vanaf klembord" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="ClipboardHotkeyButton" Tag="Clipboard" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toetscombinatie in; opent de afbeelding op het klembord" />
                        <Button Tag="Clipboard" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="OCR (tekst herkennen)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="OcrHotkeyButton" Tag="Ocr" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="Klik en druk daarna de gewenste toetscombinatie in; sleep daarna een rechthoek om de tekst erin te lezen" />
                        <Button Tag="Ocr" Style="{StaticResource FlatButton}" Content="Geen" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="Geen sneltoets gebruiken" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock Text="Gebied kiezen" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                    <CheckBox x:Name="MagnifierBox" Content="Vergrootglas tonen bij het kiezen van een gebied (knipsel en screencast)" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Opslaan">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Opslaan" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="Knipsels" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Vragen" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="Elke keer vragen waar het knipsel wordt opgeslagen" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Bladeren..." Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="SnipFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Naam" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <TextBox x:Name="SnipTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="Leeg: Knipsel met datum en tijd" />
                    </DockPanel>
                    <TextBlock x:Name="SnipTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,8" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Screencasts" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Vragen" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="Elke keer vragen waar de screencast wordt opgeslagen" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Bladeren..." Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="VideoFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Naam" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <TextBox x:Name="VideoTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="Leeg: Screencast met datum en tijd" />
                    </DockPanel>
                    <TextBlock x:Name="VideoTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,8" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TemplateHelp" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                               Text="Met een map ingesteld slaat Opslaan (Ctrl+S) direct op, met de naam hierboven. Shift+klik of Ctrl+Shift+S vraagt toch waar het bestand moet komen." />
                    <RadioButton x:Name="SaveOnlyRadio" GroupName="SaveButton" Content="Opslaan" />
                    <RadioButton x:Name="SaveAndCopyRadio" GroupName="SaveButton" Content="Opslaan en kopiëren" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Opslaan en kopiëren zet het bestand ook op het klembord, zodat je het meteen kunt plakken." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Uploaden">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Uploaden naar Zipline" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="Server" VerticalAlignment="Center" Width="110" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Verwijderen" Click="RemoveUploader_Click"
                                x:Name="RemoveUploaderButton" Margin="6,0,0,0" ToolTip="Geen uploadbestemming meer gebruiken" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Testen" Click="TestUploader_Click"
                                x:Name="TestUploaderButton" Margin="6,0,0,0" ToolTip="Een klein testplaatje uploaden" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Importeren..." Click="ImportUploader_Click"
                                Margin="6,0,0,0" ToolTip="ShareX-uploader (.sxcu) of Shell Script (.sh) uit Zipline kiezen" />
                        <TextBlock x:Name="UploaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="UploaderStatus" Style="{StaticResource Hint}" Margin="0,4,0,4" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                               Text="Maak het bestand in Zipline via Instellingen > Generate Uploaders (ShareX of Shell Script) en importeer het hier. kniip leest alleen het adres en de token uit; het script wordt niet uitgevoerd." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                               Text="Daarna staat er een knop Uploaden in de editor (Ctrl+U) en bij screencasts. De link komt op het klembord. De token wordt versleuteld bewaard voor jouw Windows-account." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Screencasts">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Screencasts" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Sneltoets: eerste keer gebied kiezen, tweede keer opname starten, derde keer stoppen. De nabewerking staat daarna op MP4 of GIF." />
                    <CheckBox x:Name="SystemAudioBox" Content="Systeemgeluid opnemen (standaard)" />
                    <CheckBox x:Name="MicrophoneBox" Content="Microfoon opnemen (standaard)" />
                    <CheckBox x:Name="ShowCursorBox" Content="Muisaanwijzer tonen" />
                    <CheckBox x:Name="HighlightClicksBox" Content="Muisklikken markeren (geel = links, blauw = rechts)" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Video" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="VideoFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="GIF" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="GifFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                        <ComboBox x:Name="GifWidthCombo" Style="{StaticResource PropCombo}" Width="150" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Weergave">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Kleurmodus" Style="{StaticResource CardTitle}" />
                    <RadioButton x:Name="ColorModeLightRadio" GroupName="ColorMode" Content="Licht" />
                    <RadioButton x:Name="ColorModeDarkRadio" GroupName="ColorMode" Content="Donker" />
                    <RadioButton x:Name="ColorModeSystemRadio" GroupName="ColorMode" Content="Systeem" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Systeem volgt de app-modus van Windows (Instellingen > Persoonlijke instellingen > Kleuren) en wisselt mee als je die verandert." />
                    <TextBlock Text="Editor" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="StraightHighlightBox" Content="Markeerstift trekt standaard een rechte horizontale streep (Shift wisselt)" />
                    <TextBlock Text="Editorvenster sluiten:" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                ToolTip="Behouden verbergt het venster; de tabbladen komen terug bij het volgende knipsel of via 'Open kniip' in het systeemvak. Afsluiten van kniip sluit altijd alles.">
                        <RadioButton x:Name="CloseAskRadio" GroupName="EditorClose" Content="Elke keer vragen" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseAllRadio" GroupName="EditorClose" Content="Alle tabbladen sluiten" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseKeepRadio" GroupName="EditorClose" Content="Tabbladen behouden" />
                    </StackPanel>
                    <TextBlock Text="Werkbalk" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="LayoutSplitRadio" GroupName="EditorLayout" Content="Split-weergave: gereedschappen boven, opslaan onder" />
                    <RadioButton x:Name="LayoutThreeSplitRadio" GroupName="EditorLayout">
                        <TextBlock Text="Drie-split: gereedschappen boven, opslaan, uploaden en kopiëren onder, screenshot, screencast en OCR apart of zwevend" TextWrapping="Wrap" />
                    </RadioButton>
                    <StackPanel Orientation="Horizontal" Margin="22,2,0,4" IsEnabled="{Binding IsChecked, ElementName=LayoutThreeSplitRadio}">
                        <RadioButton x:Name="CaptureBarLeftRadio" GroupName="CaptureBarPosition" Content="Links" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarRightRadio" GroupName="CaptureBarPosition" Content="Rechts" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarTopRadio" GroupName="CaptureBarPosition" Content="Boven" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarBottomRadio" GroupName="CaptureBarPosition" Content="Onder" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarFloatRadio" GroupName="CaptureBarPosition" Content="Zwevend" />
                    </StackPanel>
                    <RadioButton x:Name="LayoutSingleRadio" GroupName="EditorLayout" Content="Eén werkbalk met gereedschappen en acties" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Ook te wisselen via rechtsklik op de werkbalk in de editor. Daar kun je knoppen ook verslepen of verbergen." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Systeem">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Knipprogramma" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="WatchClipboardBox" Content="Klembord bewaken" />
                    <CheckBox x:Name="OnlySnippingToolBox" Content="Alleen afbeeldingen van het Knipprogramma" Margin="22,2,0,4" />
                    <CheckBox x:Name="WatchFolderBox" Content="Map Schermafbeeldingen bewaken" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" />

                    <TextBlock Text="Bij een nieuw knipsel" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="ActionNotifyRadio" GroupName="Action" Content="Melding tonen (klik om te bewerken)" />
                    <RadioButton x:Name="ActionOpenRadio" GroupName="Action" Content="Editor meteen openen" />
                    <RadioButton x:Name="ActionNothingRadio" GroupName="Action" Content="Niets doen (openen via systeemvak of 'Openen met')" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Tip: zet in het Knipprogramma 'Wijzigingen automatisch kopiëren' uit, anders ziet kniip elke pennenstreek in het Knipprogramma als nieuw knipsel." />

                    <TextBlock Text="Windows-integratie" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="AutostartBox" Content="kniip starten met Windows" />
                    <CheckBox x:Name="OpenWithBox" Content="kniip tonen in 'Openen met' (ook in het Knipprogramma: ... → Openen met)" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Alleen voor jouw gebruikersaccount; er is geen beheerder nodig en het Knipprogramma zelf wordt niet aangepast." />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="UpdateTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Update" />
                        <Ellipse x:Name="UpdateTabBadge" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource WindowBrush}"
                                 StrokeThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                 ToolTip="Er is een nieuwe versie beschikbaar" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Update" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="CurrentVersionText" Margin="0,0,0,2" />
                    <CheckBox x:Name="AutoUpdateCheckBox" Content="Automatisch controleren op nieuwe versies (bij starten en dagelijks)" />
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Click="Update_Click" Margin="0,0,6,0"
                                Visibility="Collapsed" ToolTip="Installer downloaden; kniip sluit, wordt bijgewerkt en start opnieuw" />
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="Opnieuw controleren"
                                Click="CheckUpdate_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Releasepagina" Click="ReleasePage_Click"
                                ToolTip="https://git.hibbit.net/rogier/kniip/releases" />
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,8"
                                 Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Height="300">
                        <FlowDocumentScrollViewer x:Name="ChangelogViewer" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False"
                                                  Zoom="100" MinZoom="100" MaxZoom="100" Focusable="False" />
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
