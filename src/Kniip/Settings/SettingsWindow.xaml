<Window x:Class="Kniip.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="{x:Static res:Strings.Settings_Title}" Width="720" Height="630" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/AppIcon.ico">
    <Window.Resources>
        <!-- Inhoud van een tab erft anders de blauwe, vette tekst van de geselecteerde tabkop -->
        <Style x:Key="TabPage" TargetType="StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,0,0,4" />
        </Style>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1,8,1"
                                Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Top" Background="Transparent" />
                            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True" Padding="16,14">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_Defaults}" Click="ResetDefaults_Click"
                    ToolTip="{x:Static res:Strings.Settings_DefaultsTip}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource AccentButton}" Content="{x:Static res:Strings.Common_Save}" IsDefault="True" Click="Save_Click" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ResetStatus" Style="{StaticResource Hint}" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed"
                       Text="{x:Static res:Strings.Settings_DefaultsFilled}" />
        </DockPanel>

        <TabControl Style="{StaticResource SettingsTabs}" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="{x:Static res:Strings.Settings_Hotkeys}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_Hotkeys}" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Rectangle}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="SnipHotkeyButton" Tag="Snip" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipPrint}" />
                        <Button Tag="Snip" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Window}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="WindowHotkeyButton" Tag="Window" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipAltPrint}" />
                        <Button Tag="Window" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (MP4)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="RecordHotkeyButton" Tag="Record" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTip}" />
                        <Button Tag="Record" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (GIF)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="GifHotkeyButton" Tag="Gif" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTip}" />
                        <Button Tag="Gif" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Settings_FromClipboard}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="ClipboardHotkeyButton" Tag="Clipboard" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipClipboard}" />
                        <Button Tag="Clipboard" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{x:Static res:Strings.Settings_OcrHotkey}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="OcrHotkeyButton" Tag="Ocr" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipOcr}" />
                        <Button Tag="Ocr" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Static res:Strings.Settings_SelectArea}" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                    <CheckBox x:Name="MagnifierBox" Content="{x:Static res:Strings.Settings_ShowMagnifier}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Common_Save}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Common_Save}" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Snips}" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_Ask}" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_AskSnipTip}" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Browse}" Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="SnipFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="{x:Static res:Strings.Common_Name}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <TextBox x:Name="SnipTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_SnipNameTip}" />
                    </DockPanel>
                    <TextBlock x:Name="SnipTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,8" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Screencasts" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_Ask}" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_AskVideoTip}" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Browse}" Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="VideoFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="{x:Static res:Strings.Common_Name}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <TextBox x:Name="VideoTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_VideoNameTip}" />
                    </DockPanel>
                    <TextBlock x:Name="VideoTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,8" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TemplateHelp" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                               Text="{x:Static res:Strings.Settings_SaveExplanation}" />
                    <RadioButton x:Name="SaveOnlyRadio" GroupName="SaveButton" Content="{x:Static res:Strings.Common_Save}" />
                    <RadioButton x:Name="SaveAndCopyRadio" GroupName="SaveButton" Content="{x:Static res:Strings.Settings_SaveAndCopy}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_SaveAndCopyExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Common_Upload}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_UploadZipline}" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="Server" VerticalAlignment="Center" Width="110" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Settings_RemoveUpload}" Click="RemoveUploader_Click"
                                x:Name="RemoveUploaderButton" Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_RemoveUploadTip}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_Test}" Click="TestUploader_Click"
                                x:Name="TestUploaderButton" Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_TestTip}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_Import}" Click="ImportUploader_Click"
                                Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_ImportTip}" />
                        <TextBlock x:Name="UploaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="UploaderStatus" Style="{StaticResource Hint}" Margin="0,4,0,4" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                               Text="{x:Static res:Strings.Settings_ImportExplanation}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                               Text="{x:Static res:Strings.Settings_UploadExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Screencasts">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Screencasts" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="{x:Static res:Strings.Settings_ScreencastExplanation}" />
                    <CheckBox x:Name="SystemAudioBox" Content="{x:Static res:Strings.Settings_SystemAudio}" />
                    <CheckBox x:Name="MicrophoneBox" Content="{x:Static res:Strings.Settings_Microphone}" />
                    <CheckBox x:Name="ShowCursorBox" Content="{x:Static res:Strings.Settings_ShowCursor}" />
                    <CheckBox x:Name="HighlightClicksBox" Content="{x:Static res:Strings.Settings_HighlightClicks}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Video" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="VideoFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="GIF" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="GifFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                        <ComboBox x:Name="GifWidthCombo" Style="{StaticResource PropCombo}" Width="150" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Appearance}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_ColorMode}" Style="{StaticResource CardTitle}" />
                    <RadioButton x:Name="ColorModeLightRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_Light}" />
                    <RadioButton x:Name="ColorModeDarkRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_Dark}" />
                    <RadioButton x:Name="ColorModeSystemRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_System}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_SystemExplanation}" />
                    <TextBlock Text="Editor" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="StraightHighlightBox" Content="{x:Static res:Strings.Settings_HighlighterStraight}" />
                    <TextBlock Text="{x:Static res:Strings.Settings_CloseEditor}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                ToolTip="{x:Static res:Strings.Settings_CloseEditorTip}">
                        <RadioButton x:Name="CloseAskRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Settings_AskEveryTime}" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseAllRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Common_CloseAllTabs}" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseKeepRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Common_KeepTabs}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Toolbar}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="LayoutSplitRadio" GroupName="EditorLayout" Content="{x:Static res:Strings.Settings_SplitLayout}" />
                    <RadioButton x:Name="LayoutThreeSplitRadio" GroupName="EditorLayout">
                        <TextBlock Text="{x:Static res:Strings.Settings_ThreeSplitLayout}" TextWrapping="Wrap" />
                    </RadioButton>
                    <StackPanel Orientation="Horizontal" Margin="22,2,0,4" IsEnabled="{Binding IsChecked, ElementName=LayoutThreeSplitRadio}">
                        <RadioButton x:Name="CaptureBarLeftRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Left}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarRightRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Right}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarTopRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Top}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarBottomRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Bottom}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarFloatRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Floating}" />
                    </StackPanel>
                    <RadioButton x:Name="LayoutSingleRadio" GroupName="EditorLayout" Content="{x:Static res:Strings.Settings_SingleLayout}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_ToolbarExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_System}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource CardTitle}" />
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource PropCombo}" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_LanguageExplanation}" />

                    <TextBlock Text="{x:Static res:Strings.Common_SnippingTool}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="WatchClipboardBox" Content="{x:Static res:Strings.Settings_WatchClipboard}" />
                    <CheckBox x:Name="OnlySnippingToolBox" Content="{x:Static res:Strings.Settings_OnlySnippingTool}" Margin="22,2,0,4" />
                    <CheckBox x:Name="WatchFolderBox" Content="{x:Static res:Strings.Settings_WatchScreenshots}" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" />

                    <TextBlock Text="{x:Static res:Strings.Settings_OnNewSnip}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="ActionNotifyRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_ShowNotification}" />
                    <RadioButton x:Name="ActionOpenRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_OpenEditor}" />
                    <RadioButton x:Name="ActionNothingRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_DoNothing}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{x:Static res:Strings.Settings_SnippingToolTip}" />

                    <TextBlock Text="{x:Static res:Strings.Settings_WindowsIntegration}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="AutostartBox" Content="{x:Static res:Strings.Settings_Autostart}" />
                    <CheckBox x:Name="OpenWithBox" Content="{x:Static res:Strings.Settings_OpenWith}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_IntegrationExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="UpdateTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Update" />
                        <Ellipse x:Name="UpdateTabBadge" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource WindowBrush}"
                                 StrokeThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                 ToolTip="{x:Static res:Strings.Update_Available}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Update" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="CurrentVersionText" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AutoUpdateCheckBox" Content="{x:Static res:Strings.Settings_AutoCheck}" VerticalAlignment="Center" />
                        <Grid Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=AutoUpdateCheckBox}">
                            <ToggleButton x:Name="UpdateIntervalToggle" Style="{StaticResource FlatButton}" Padding="8,3" MinWidth="0" MinHeight="26"
                                          BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UpdateIntervalText" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="8" Margin="6,1,0,0"
                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=UpdateIntervalToggle}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=UpdateIntervalToggle, Mode=TwoWay}">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,4,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Slider x:Name="UpdateIntervalSlider" Width="200" Minimum="1" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ValueChanged="UpdateInterval_Changed" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_UpdateIntervalTip}" FontSize="11" Width="200" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Click="Update_Click" Margin="0,0,6,0"
                                Visibility="Collapsed" ToolTip="{x:Static res:Strings.Settings_InstallTip}" />
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_CheckAgain}"
                                Click="CheckUpdate_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Settings_ReleasePage}" Click="ReleasePage_Click"
                                ToolTip="https://github.com/R0GGER/kniip/releases" />
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,8"
                                 Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Height="300">
                        <FlowDocumentScrollViewer x:Name="ChangelogViewer" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False"
                                                  Zoom="100" MinZoom="100" MaxZoom="100" Focusable="False" />
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
