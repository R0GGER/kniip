<Window x:Class="Kniip.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="{x:Static res:Strings.Settings_Title}" Width="820" Height="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/AppIcon.ico">
    <Window.Resources>
        <!-- Inhoud van een tab erft anders de blauwe, vette tekst van de geselecteerde tabkop -->
        <Style x:Key="TabPage" TargetType="StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,0,0,4" />
        </Style>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1,8,1"
                                Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Top" Background="Transparent" />
                            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True" Padding="16,14">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_Defaults}" Click="ResetDefaults_Click"
                    ToolTip="{x:Static res:Strings.Settings_DefaultsTip}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Close}" IsCancel="True" Click="Close_Click" />
            <TextBlock x:Name="SaveStatus" Style="{StaticResource Hint}" Margin="10,0" VerticalAlignment="Center"
                       Text="{x:Static res:Strings.Settings_AutoSaveHint}" />
        </DockPanel>

        <TabControl Style="{StaticResource SettingsTabs}" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="{x:Static res:Strings.Settings_Hotkeys}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_Hotkeys}" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Rectangle}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="SnipHotkeyButton" Tag="Snip" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipPrint}" />
                        <Button Tag="Snip" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Window}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="WindowHotkeyButton" Tag="Window" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipAltPrint}" />
                        <Button Tag="Window" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (MP4)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="RecordHotkeyButton" Tag="Record" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTip}" />
                        <Button Tag="Record" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Screencast (GIF)" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="GifHotkeyButton" Tag="Gif" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTip}" />
                        <Button Tag="Gif" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Settings_FromClipboard}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="ClipboardHotkeyButton" Tag="Clipboard" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipClipboard}" />
                        <Button Tag="Clipboard" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Settings_UploadClipboardHotkey}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="UploadClipboardHotkeyButton" Tag="UploadClipboard" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipUploadClipboard}" />
                        <Button Tag="UploadClipboard" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{x:Static res:Strings.Settings_OcrHotkey}" VerticalAlignment="Center" Width="150" />
                        <Button x:Name="OcrHotkeyButton" Tag="Ocr" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTipOcr}" />
                        <Button Tag="Ocr" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}" Click="ClearHotkey_Click" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Static res:Strings.Settings_SelectArea}" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                    <CheckBox x:Name="MagnifierBox" Content="{x:Static res:Strings.Settings_ShowMagnifier}" />
                    <CheckBox x:Name="WindowShadowBox" Content="{x:Static res:Strings.Settings_WindowShadow}" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Common_Save}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Common_Save}" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="{x:Static res:Strings.Common_Snips}" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_Ask}" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_AskSnipTip}" />
                        <Button Tag="Snip" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Browse}" Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="SnipFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Settings_Subfolder}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <Button Tag="SnipFolder" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                Content="{x:Static res:Strings.Settings_InsertToken}" Click="InsertToken_Click" />
                        <TextBox x:Name="SnipFolderTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_SubfolderTip}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="{x:Static res:Strings.Settings_FileName}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <Button Tag="SnipFile" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                Content="{x:Static res:Strings.Settings_InsertToken}" Click="InsertToken_Click" />
                        <TextBox x:Name="SnipTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_SnipNameTip}" />
                    </DockPanel>
                    <TextBlock x:Name="SnipTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,0" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock Text="Screencasts" VerticalAlignment="Center" Width="110" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_Ask}" Click="ClearSaveFolder_Click"
                                Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_AskVideoTip}" />
                        <Button Tag="Video" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Browse}" Click="BrowseSaveFolder_Click"
                                Margin="6,0,0,0" />
                        <TextBlock x:Name="VideoFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{x:Static res:Strings.Settings_Subfolder}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <Button Tag="VideoFolder" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                Content="{x:Static res:Strings.Settings_InsertToken}" Click="InsertToken_Click" />
                        <TextBox x:Name="VideoFolderTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_SubfolderTip}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="{x:Static res:Strings.Settings_FileName}" VerticalAlignment="Center" Width="110" Padding="12,0,0,0" />
                        <Button Tag="VideoFile" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                Content="{x:Static res:Strings.Settings_InsertToken}" Click="InsertToken_Click" />
                        <TextBox x:Name="VideoTemplateBox" Height="26" VerticalContentAlignment="Center" TextChanged="Template_TextChanged"
                                 ToolTip="{x:Static res:Strings.Settings_VideoNameTip}" />
                    </DockPanel>
                    <TextBlock x:Name="VideoTemplatePreview" Style="{StaticResource Hint}" Margin="110,0,0,0" TextTrimming="CharacterEllipsis" />
                    <RadioButton x:Name="SaveOnlyRadio" GroupName="SaveButton" Content="{x:Static res:Strings.Common_Save}" Margin="0,12,0,4" />
                    <RadioButton x:Name="SaveAndCopyRadio" GroupName="SaveButton" Content="{x:Static res:Strings.Settings_SaveAndCopy}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_SaveAndCopyExplanation}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,4"
                               Text="{x:Static res:Strings.Settings_SaveExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Common_Upload}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_UploadDestinations}" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <Button Style="{StaticResource AccentButton}" Content="{x:Static res:Strings.Settings_Import}" Click="ImportUploader_Click"
                                Margin="0" ToolTip="{x:Static res:Strings.Settings_ImportTip}" />
                        <TextBlock Text="{x:Static res:Strings.Settings_UploadOrNew}" Foreground="{DynamicResource SubtleTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,6,0" />
                        <Button Tag="ftp" Style="{StaticResource SecondaryButton}" Content="FTP" Click="NewUploader_Click" Margin="0,0,6,0"
                                ToolTip="FTP / FTPS" />
                        <Button Tag="sftp" Style="{StaticResource SecondaryButton}" Content="SFTP" Click="NewUploader_Click" Margin="0,0,6,0" />
                        <Button Tag="scp" Style="{StaticResource SecondaryButton}" Content="SCP" Click="NewUploader_Click" Margin="0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="{x:Static res:Strings.Settings_ImportExplanation}" />

                    <Border x:Name="NoUploadersText" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="14,16" Margin="0,0,0,6">
                        <TextBlock Text="{x:Static res:Strings.Settings_NoUploaders}" Foreground="{DynamicResource SubtleTextBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    </Border>
                    <ScrollViewer MaxHeight="216" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="UploaderList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,7,4,7" Margin="0,0,0,6" SnapsToDevicePixels="True"
                                            MouseLeftButtonDown="UploaderRow_MouseLeftButtonDown">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0"
                                                    Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15"
                                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="StarButton" Style="{StaticResource FlatButton}" MinWidth="30" MinHeight="30" Padding="6"
                                                        Click="DefaultUploader_Click" ToolTip="{x:Static res:Strings.Settings_UploadMakeDefault}">
                                                    <TextBlock x:Name="Star" Text="&#xE734;" Style="{StaticResource IconText}" FontSize="14"
                                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource FlatButton}" MinWidth="30" MinHeight="30" Padding="6"
                                                        Click="EditUploader_Click" ToolTip="{x:Static res:Strings.Settings_UploadEdit}">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="14" />
                                                </Button>
                                                <Button Style="{StaticResource FlatButton}" MinWidth="30" MinHeight="30" Padding="6"
                                                        Click="UploaderMore_Click" ToolTip="{x:Static res:Strings.Settings_UploadMore}">
                                                    <TextBlock Text="&#xE712;" Style="{StaticResource IconText}" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                                    <Border x:Name="DefaultBadge" Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                                            Padding="7,0,7,1" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                                        <TextBlock Text="{x:Static res:Strings.Settings_UploadDefault}" Foreground="White" FontSize="11" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                            <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            <Setter TargetName="StarButton" Property="ToolTip" Value="{x:Static res:Strings.Settings_UploadIsDefault}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="UploaderStatus" Style="{StaticResource Hint}" Margin="0,2,0,4" Visibility="Collapsed" />
                    <StackPanel x:Name="PerKindPanel">
                        <TextBlock Text="{x:Static res:Strings.Settings_UploadPerKind}" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static res:Strings.Settings_UploadKindMedia}" VerticalAlignment="Center" Width="170" />
                            <ComboBox x:Name="MediaUploaderCombo" Tag="Media" Style="{StaticResource PropCombo}" Width="260"
                                      SelectionChanged="KindUploader_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static res:Strings.Settings_UploadKindText}" VerticalAlignment="Center" Width="170" />
                            <ComboBox x:Name="TextUploaderCombo" Tag="Text" Style="{StaticResource PropCombo}" Width="260"
                                      SelectionChanged="KindUploader_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{x:Static res:Strings.Settings_UploadKindFile}" VerticalAlignment="Center" Width="170" />
                            <ComboBox x:Name="FileUploaderCombo" Tag="File" Style="{StaticResource PropCombo}" Width="260"
                                      SelectionChanged="KindUploader_SelectionChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.Settings_UploadPerKindHint}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,4"
                               Text="{x:Static res:Strings.Settings_UploadExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WorkflowsTab" Header="{x:Static res:Strings.Settings_Workflows}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-10,0">
                    <StackPanel Style="{StaticResource TabPage}" Margin="0,0,10,0">
                        <TextBlock Text="{x:Static res:Strings.Settings_Workflows}" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{x:Static res:Strings.Settings_WorkflowsExplanation}" />
                        <CheckBox x:Name="WorkflowBarVisibleBox" Content="{x:Static res:Strings.Tray_WorkflowBar}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{x:Static res:Strings.Settings_WorkflowBarHint}" />
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                <Button Style="{StaticResource FlatButton}" Click="NewWorkflow_Click" ToolTip="{x:Static res:Strings.Settings_WorkflowNew}">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                                <Button x:Name="DuplicateWorkflowButton" Style="{StaticResource FlatButton}" Click="DuplicateWorkflow_Click"
                                        ToolTip="{x:Static res:Strings.Settings_WorkflowDuplicate}">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                                <Button x:Name="WorkflowUpButton" Tag="-1" Style="{StaticResource FlatButton}" Click="MoveWorkflow_Click"
                                        ToolTip="{x:Static res:Strings.Settings_MoveUp}">
                                    <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                                <Button x:Name="WorkflowDownButton" Tag="1" Style="{StaticResource FlatButton}" Click="MoveWorkflow_Click"
                                        ToolTip="{x:Static res:Strings.Settings_MoveDown}">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                                <Button x:Name="RemoveWorkflowButton" Style="{StaticResource FlatButton}" Click="RemoveWorkflow_Click"
                                        ToolTip="{x:Static res:Strings.Settings_WorkflowRemove}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <Grid>
                                <Border x:Name="NoWorkflowsText" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14,16">
                                    <TextBlock Text="{x:Static res:Strings.Settings_NoWorkflows}" Foreground="{DynamicResource SubtleTextBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <ScrollViewer MaxHeight="172" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl x:Name="WorkflowList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,5" Margin="0,0,0,4" SnapsToDevicePixels="True"
                                                        MouseLeftButtonDown="WorkflowRow_MouseLeftButtonDown">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0"
                                                                Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="14"
                                                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="Warning" DockPanel.Dock="Right" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="14"
                                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Visibility="Collapsed"
                                                                   ToolTip="{Binding Problem}" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hotkey}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="8,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                        <Setter TargetName="Warning" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>

                        <StackPanel x:Name="WorkflowDetails">
                            <DockPanel Margin="0,6,0,4">
                                <TextBlock Text="{x:Static res:Strings.Settings_WorkflowName}" VerticalAlignment="Center" Width="110" />
                                <TextBox x:Name="WorkflowNameBox" Height="26" VerticalContentAlignment="Center" TextChanged="WorkflowName_TextChanged" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{x:Static res:Strings.Settings_WorkflowIcon}" VerticalAlignment="Center" Width="110" />
                                <Button x:Name="WorkflowIconButton" Style="{StaticResource SecondaryButton}" Margin="0" MinWidth="44" Click="WorkflowIcon_Click"
                                        ToolTip="{x:Static res:Strings.Settings_WorkflowIconTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18">
                                            <TextBlock x:Name="WorkflowIconGlyph" Style="{StaticResource IconText}" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="WorkflowIconImage" Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{x:Static res:Strings.Settings_WorkflowHotkey}" VerticalAlignment="Center" Width="110" />
                                <Button x:Name="WorkflowHotkeyButton" Style="{StaticResource SecondaryButton}" Width="170" Margin="0"
                                        Click="HotkeyButton_Click" ToolTip="{x:Static res:Strings.Settings_HotkeyTip}" />
                                <Button x:Name="WorkflowHotkeyClearButton" Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Common_None}"
                                        Click="ClearHotkey_Click" Margin="6,0,0,0" ToolTip="{x:Static res:Strings.Settings_NoHotkey}" />
                            </StackPanel>
                            <TextBlock x:Name="WorkflowHotkeyHint" Style="{StaticResource Hint}" Margin="110,0,0,4" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="110,0,0,4">
                                <CheckBox x:Name="WorkflowTrayBox" Content="{x:Static res:Strings.Settings_WorkflowInTray}" Click="WorkflowOption_Click" />
                                <CheckBox x:Name="WorkflowBarBox" Content="{x:Static res:Strings.Settings_WorkflowInBar}" Click="WorkflowOption_Click" Margin="16,4,0,4" />
                            </StackPanel>

                            <TextBlock Text="{x:Static res:Strings.Settings_WorkflowSteps}" Style="{StaticResource CardTitle}" Margin="0,10,0,6" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                                    <Button x:Name="AddStepButton" Style="{StaticResource FlatButton}" Click="AddStep_Click" ToolTip="{x:Static res:Strings.Settings_WorkflowAddStep}">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="14" />
                                    </Button>
                                    <Button x:Name="StepUpButton" Tag="-1" Style="{StaticResource FlatButton}" Click="MoveStep_Click" ToolTip="{x:Static res:Strings.Settings_MoveUp}">
                                        <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="14" />
                                    </Button>
                                    <Button x:Name="StepDownButton" Tag="1" Style="{StaticResource FlatButton}" Click="MoveStep_Click" ToolTip="{x:Static res:Strings.Settings_MoveDown}">
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="14" />
                                    </Button>
                                    <Button x:Name="RemoveStepButton" Style="{StaticResource FlatButton}" Click="RemoveStep_Click" ToolTip="{x:Static res:Strings.Settings_WorkflowRemoveStep}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                                <ItemsControl x:Name="StepList" Focusable="False" MinHeight="40">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,4" Margin="0,0,0,4" SnapsToDevicePixels="True"
                                                    MouseLeftButtonDown="StepRow_MouseLeftButtonDown">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Foreground="{DynamicResource SubtleTextBrush}" Width="20"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="14"
                                                               Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <StackPanel x:Name="StepUploadPanel" Orientation="Horizontal" Margin="0,6,0,4" Visibility="Collapsed">
                                <TextBlock Text="{x:Static res:Strings.Settings_WorkflowDestination}" VerticalAlignment="Center" Width="110" />
                                <ComboBox x:Name="StepUploaderCombo" Style="{StaticResource PropCombo}" Width="260" SelectionChanged="StepUploader_SelectionChanged" />
                            </StackPanel>
                            <CheckBox x:Name="StepAskBox" Content="{x:Static res:Strings.Settings_WorkflowAskLocation}" Margin="0,6,0,4"
                                      Visibility="Collapsed" Click="StepAsk_Click" />
                            <StackPanel x:Name="StepOpenWithPanel" Margin="0,6,0,4" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{x:Static res:Strings.Settings_WorkflowProgram}" VerticalAlignment="Center" Width="110" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Browse}"
                                            Click="BrowseProgram_Click" Margin="6,0,0,0" />
                                    <TextBox x:Name="StepProgramBox" Height="26" VerticalContentAlignment="Center" TextChanged="StepProgram_TextChanged" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="{x:Static res:Strings.Settings_WorkflowArguments}" VerticalAlignment="Center" Width="110" />
                                    <TextBox x:Name="StepArgumentsBox" Height="26" VerticalContentAlignment="Center" TextChanged="StepArguments_TextChanged"
                                             ToolTip="{x:Static res:Strings.Settings_WorkflowArgumentsTip}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="110,2,0,0" Text="{x:Static res:Strings.Settings_WorkflowArgumentsTip}" />
                            </StackPanel>
                            <TextBlock x:Name="StepHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />

                            <StackPanel x:Name="WorkflowProblemsPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock x:Name="WorkflowProblemsText" TextWrapping="Wrap" MaxWidth="420" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Screencasts">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Screencasts" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="{x:Static res:Strings.Settings_ScreencastExplanation}" />
                    <CheckBox x:Name="SystemAudioBox" Content="{x:Static res:Strings.Settings_SystemAudio}" />
                    <CheckBox x:Name="MicrophoneBox" Content="{x:Static res:Strings.Settings_Microphone}" />
                    <CheckBox x:Name="ShowCursorBox" Content="{x:Static res:Strings.Settings_ShowCursor}" />
                    <CheckBox x:Name="HighlightClicksBox" Content="{x:Static res:Strings.Settings_HighlightClicks}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Video" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="VideoFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="GIF" VerticalAlignment="Center" Width="110" />
                        <ComboBox x:Name="GifFpsCombo" Style="{StaticResource PropCombo}" Width="130" />
                        <ComboBox x:Name="GifWidthCombo" Style="{StaticResource PropCombo}" Width="150" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Appearance}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_ColorMode}" Style="{StaticResource CardTitle}" />
                    <RadioButton x:Name="ColorModeLightRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_Light}" />
                    <RadioButton x:Name="ColorModeDarkRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_Dark}" />
                    <RadioButton x:Name="ColorModeSystemRadio" GroupName="ColorMode" Content="{x:Static res:Strings.Settings_System}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_SystemExplanation}" />
                    <TextBlock Text="Editor" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="StraightHighlightBox" Content="{x:Static res:Strings.Settings_HighlighterStraight}" />
                    <TextBlock Text="{x:Static res:Strings.Settings_CloseEditor}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                ToolTip="{x:Static res:Strings.Settings_CloseEditorTip}">
                        <RadioButton x:Name="CloseAskRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Settings_AskEveryTime}" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseAllRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Common_CloseAllTabs}" Margin="0,0,14,0" />
                        <RadioButton x:Name="CloseKeepRadio" GroupName="EditorClose" Content="{x:Static res:Strings.Common_KeepTabs}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Toolbar}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="LayoutSplitRadio" GroupName="EditorLayout" Content="{x:Static res:Strings.Settings_SplitLayout}" />
                    <RadioButton x:Name="LayoutThreeSplitRadio" GroupName="EditorLayout">
                        <TextBlock Text="{x:Static res:Strings.Settings_ThreeSplitLayout}" TextWrapping="Wrap" />
                    </RadioButton>
                    <StackPanel Orientation="Horizontal" Margin="22,2,0,4" IsEnabled="{Binding IsChecked, ElementName=LayoutThreeSplitRadio}">
                        <RadioButton x:Name="CaptureBarLeftRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Left}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarRightRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Right}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarTopRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Top}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarBottomRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Bottom}" Margin="0,0,16,0" />
                        <RadioButton x:Name="CaptureBarFloatRadio" GroupName="CaptureBarPosition" Content="{x:Static res:Strings.Common_Floating}" />
                    </StackPanel>
                    <RadioButton x:Name="LayoutSingleRadio" GroupName="EditorLayout" Content="{x:Static res:Strings.Settings_SingleLayout}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_ToolbarExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_System}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource CardTitle}" />
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource PropCombo}" Width="240" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_LanguageExplanation}" />

                    <TextBlock Text="{x:Static res:Strings.Common_SnippingTool}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="WatchClipboardBox" Content="{x:Static res:Strings.Settings_WatchClipboard}" />
                    <CheckBox x:Name="OnlySnippingToolBox" Content="{x:Static res:Strings.Settings_OnlySnippingTool}" Margin="22,2,0,4" />
                    <CheckBox x:Name="WatchFolderBox" Content="{x:Static res:Strings.Settings_WatchScreenshots}" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" />

                    <TextBlock Text="{x:Static res:Strings.Settings_OnNewSnip}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <RadioButton x:Name="ActionNotifyRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_ShowNotification}" />
                    <RadioButton x:Name="ActionOpenRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_OpenEditor}" />
                    <RadioButton x:Name="ActionNothingRadio" GroupName="Action" Content="{x:Static res:Strings.Settings_DoNothing}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="{x:Static res:Strings.Settings_SnippingToolTip}" />

                    <TextBlock Text="{x:Static res:Strings.Settings_WindowsIntegration}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <CheckBox x:Name="AutostartBox" Content="{x:Static res:Strings.Settings_Autostart}" Click="ShellOption_Click" />
                    <CheckBox x:Name="OpenWithBox" Content="{x:Static res:Strings.Settings_OpenWith}" Click="ShellOption_Click" />
                    <CheckBox x:Name="SendToBox" Content="{x:Static res:Strings.Settings_SendTo}" Click="ShellOption_Click" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_IntegrationExplanation}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.Settings_Backup}">
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="{x:Static res:Strings.Settings_BackupTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{x:Static res:Strings.Settings_BackupExplanation}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_BackupCreate}" Click="BackupSettings_Click"
                            HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <CheckBox x:Name="PlainTokenBox" Content="{x:Static res:Strings.Settings_BackupPlainToken}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Static res:Strings.Settings_BackupPlainTokenExplanation}" />
                    <TextBlock x:Name="BackupStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />

                    <TextBlock Text="{x:Static res:Strings.Settings_Restore}" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{x:Static res:Strings.Settings_RestoreExplanation}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_RestoreButton}" Click="RestoreSettings_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="UpdateTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Update" />
                        <Ellipse x:Name="UpdateTabBadge" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource WindowBrush}"
                                 StrokeThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                 ToolTip="{x:Static res:Strings.Update_Available}" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Style="{StaticResource TabPage}">
                    <TextBlock Text="Update" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="CurrentVersionText" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AutoUpdateCheckBox" Content="{x:Static res:Strings.Settings_AutoCheck}" VerticalAlignment="Center" />
                        <Grid Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=AutoUpdateCheckBox}">
                            <ToggleButton x:Name="UpdateIntervalToggle" Style="{StaticResource FlatButton}" Padding="8,3" MinWidth="0" MinHeight="26"
                                          BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UpdateIntervalText" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="8" Margin="6,1,0,0"
                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup PlacementTarget="{Binding ElementName=UpdateIntervalToggle}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=UpdateIntervalToggle, Mode=TwoWay}">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,4,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Slider x:Name="UpdateIntervalSlider" Width="200" Minimum="1" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ValueChanged="UpdateInterval_Changed" />
                                        <TextBlock Text="{x:Static res:Strings.Settings_UpdateIntervalTip}" FontSize="11" Width="200" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Click="Update_Click" Margin="0,0,6,0"
                                Visibility="Collapsed" ToolTip="{x:Static res:Strings.Settings_InstallTip}" />
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Settings_CheckAgain}"
                                Click="CheckUpdate_Click" Margin="0,0,6,0" />
                        <Button Style="{StaticResource FlatButton}" Content="{x:Static res:Strings.Settings_ReleasePage}" Click="ReleasePage_Click"
                                ToolTip="https://github.com/R0GGER/kniip/releases" />
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,8"
                                 Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Height="300">
                        <FlowDocumentScrollViewer x:Name="ChangelogViewer" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False"
                                                  Zoom="100" MinZoom="100" MaxZoom="100" Focusable="False" />
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
