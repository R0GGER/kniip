<Window x:Class="Kniip.Notifications.SnipToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="kniip" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True">
    <Border Margin="16" Background="{DynamicResource ToastBrush}" CornerRadius="8" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid Width="340" Margin="14,12,10,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Image Source="pack://application:,,,/AppIcon.ico" Width="16" Height="16" />
                <TextBlock Text="kniip" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" MinWidth="28" MinHeight="24" Padding="4,2"
                    VerticalAlignment="Top" Click="Close_Click" ToolTip="{x:Static res:Strings.Common_Close}">
                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="10" />
            </Button>

            <Border Grid.Row="1" Width="110" Height="72" CornerRadius="4" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource ControlPressedBrush}" Cursor="Hand" MouseLeftButtonUp="Thumbnail_Click" ClipToBounds="True">
                <Image x:Name="Thumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Common_NewSnip}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="DetailText" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="Edit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0" Foreground="White" />
                            <TextBlock Text="{x:Static res:Strings.Toast_Edit}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0" Content="{x:Static res:Strings.Toast_Dismiss}" Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
