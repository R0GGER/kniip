<Window x:Class="Kniip.Capture.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="kniip" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Segoe UI" Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True">
    <Border Margin="10" Background="{DynamicResource ToastBrush}" CornerRadius="8" BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="Border_Click" ToolTip="{x:Static res:Strings.Countdown_ClickToCancel}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" Margin="12,8,14,8">
            <TextBlock x:Name="SecondsText" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                       MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Countdown_SnipIn}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.Countdown_EscToCancel}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
