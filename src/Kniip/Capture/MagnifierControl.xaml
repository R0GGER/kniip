<UserControl x:Class="Kniip.Capture.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
    <StackPanel>
        <Grid Width="120" Height="120">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
            </Grid.Effect>
            <Grid>
                <Grid.Clip>
                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
                </Grid.Clip>
                <Image x:Name="Zoom" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#40000000" Thickness="0.5" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,8,8" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Height="8" VerticalAlignment="Top" Margin="0,56,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                <Rectangle Width="8" HorizontalAlignment="Left" Margin="56,0,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                <Rectangle Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="55,55,0,0"
                           Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,56,0,0"
                           Stroke="#202020" StrokeThickness="1" />
            </Grid>
            <Ellipse Stroke="White" StrokeThickness="2" />
        </Grid>
        <Border HorizontalAlignment="Center" Margin="0,6,0,0" Background="#E6202020" CornerRadius="4" Padding="6,2">
            <TextBlock x:Name="CoordinateText" Foreground="White" FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>
