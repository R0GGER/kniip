<Window x:Class="Kniip.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="{x:Static res:Strings.History_Title}" Width="980" Height="620" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/AppIcon.ico">
    <Window.Resources>
        <Style x:Key="ViewToggle" TargetType="RadioButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SmallThumb">
            <Grid Width="40" Height="28">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" Foreground="{DynamicResource SubtleTextBrush}"
                           Visibility="{Binding NoThumbnailVisibility}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <RadioButton x:Name="ListToggle" Style="{StaticResource ViewToggle}" GroupName="View" Checked="View_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.History_List}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="GridToggle" Style="{StaticResource ViewToggle}" GroupName="View" Checked="View_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE91B;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:Strings.History_Thumbnails}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <Grid DockPanel.Dock="Right" Width="260" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Height="30" Padding="26,0,6,0" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Left" Margin="8,0,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="{x:Static res:Strings.History_Search}" Margin="27,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Close}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="{x:Static res:Strings.History_Clear}" Style="{StaticResource SecondaryButton}"
                    Click="Clear_Click" />
        </DockPanel>

        <Grid>
            <ListView x:Name="ListItems" ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Single"
                      Background="{DynamicResource CardBrush}" Foreground="{DynamicResource InkBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}" ContextMenuOpening="Items_ContextMenuOpening">
                <ListView.ContextMenu>
                    <ContextMenu />
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="56" CellTemplate="{StaticResource SmallThumb}" />
                        <GridViewColumn Header="{x:Static res:Strings.History_Date}" Width="140" DisplayMemberBinding="{Binding TimeText}" />
                        <GridViewColumn Header="{x:Static res:Strings.History_Kind}" Width="120" DisplayMemberBinding="{Binding Entry.KindText}" />
                        <GridViewColumn Header="{x:Static res:Strings.Common_Name}" Width="200" DisplayMemberBinding="{Binding Entry.Name}" />
                        <GridViewColumn Header="{x:Static res:Strings.History_Folder}" Width="200" DisplayMemberBinding="{Binding Folder}" />
                        <GridViewColumn Header="Link" Width="220" DisplayMemberBinding="{Binding Entry.Url}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <ListBox x:Name="GridItems" ItemContainerStyle="{StaticResource TileStyle}" SelectionMode="Single" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ContextMenuOpening="Items_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="180" ToolTip="{Binding ToolTip}">
                            <Grid Height="120" Background="{DynamicResource WindowBrush}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="32"
                                           Foreground="{DynamicResource SubtleTextBrush}" Visibility="{Binding NoThumbnailVisibility}" />
                            </Grid>
                            <TextBlock Text="{Binding Entry.Name}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SubtleTextBrush}" Visibility="Collapsed"
                       Text="{x:Static res:Strings.History_Empty}" />
        </Grid>
    </DockPanel>
</Window>
