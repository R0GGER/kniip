<UserControl x:Class="Kniip.Editor.EmojiPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Kniip.Resources"
             xmlns:local="clr-namespace:Kniip.Editor"
             VerticalAlignment="Center">
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource FlatButton}" Padding="6,4" MinWidth="0" MinHeight="30"
                      BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBrush}" ToolTip="{x:Static res:Strings.Emoji_Choose}">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="Face" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Margin="5,0,1,0" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="PopupPanel" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="Popup_Opened"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,10,10"
                    PreviewKeyDown="Popup_PreviewKeyDown">
                <Border.Resources>
                    <DataTemplate DataType="{x:Type local:EmojiHeaderRow}">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"
                                   Margin="4,8,0,4" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:EmojiCellRow}">
                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:EmojiCell}">
                                    <Button Style="{StaticResource FlatButton}" Width="36" Height="36" MinWidth="0" MinHeight="0" Padding="0"
                                            Margin="0" Click="Cell_Click" MouseEnter="Cell_MouseEnter">
                                        <Image Source="{Binding Image}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </Border.Resources>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <DockPanel Width="352">
                    <!-- Zoeken -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Height="30" Padding="28,0,6,0" VerticalContentAlignment="Center" FontSize="13"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Foreground="#8A8A8A"
                                   HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="{x:Static res:Strings.Emoji_Search}" Foreground="#8A8A8A" FontSize="13"
                                   VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Categorieën -->
                    <StackPanel x:Name="TabPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" />

                    <!-- Voorbeeld en huidskleur -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="2,8,0,0"
                            Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel x:Name="TonePanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                            <Image x:Name="PreviewImage" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center" Margin="8,0,6,0">
                                <TextBlock x:Name="PreviewName" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PreviewCode" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Raster -->
                    <Grid Height="300">
                        <ItemsControl x:Name="EmojiList" Focusable="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer x:Name="PART_Scroller" CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControl>
                        <TextBlock x:Name="NoResultsText" Text="{x:Static res:Strings.Emoji_NoneFound}" Foreground="{DynamicResource SubtleTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
