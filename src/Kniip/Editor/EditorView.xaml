<UserControl x:Class="Kniip.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kniip.Editor"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
             FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
             AllowDrop="True" PreviewDragEnter="View_PreviewDragOver" PreviewDragOver="View_PreviewDragOver" PreviewDrop="View_PreviewDrop">
    <UserControl.Resources>
        <local:CornerPreviewConverter x:Key="CornerPreview" />
        <local:CursorIconConverter x:Key="CursorIcon" />
        <local:ShapeIconConverter x:Key="ShapeIcon" />

        <Style x:Key="ArrangeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ArrangeAccent" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style x:Key="ArrangeDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
        </Style>

        <!-- Dikte: stip die meegroeit met de lijndikte -->
        <DataTemplate x:Key="ThicknessTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Fill="{DynamicResource InkBrush}" Width="{Binding}" Height="{Binding}"
                             MinWidth="2" MinHeight="2" MaxWidth="15" MaxHeight="15"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Line x:Name="NoneLine" X1="3" Y1="13" X2="13" Y2="3" Stroke="#E81123" StrokeThickness="1.5" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="Label" Text="{Binding StringFormat={}{0} px}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="0">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoneLine" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Text" Value="Geen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Lijnstijl: voorbeeldlijn -->
        <DataTemplate x:Key="DashTemplate">
            <StackPanel Orientation="Horizontal">
                <Line x:Name="Sample" X1="1" Y1="8" X2="35" Y2="8" Width="36" Height="16" Stroke="{DynamicResource InkBrush}"
                      StrokeThickness="2" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Text="Doorgetrokken" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:LineDash.Dash}">
                    <Setter TargetName="Sample" Property="StrokeDashArray" Value="3 2" />
                    <Setter TargetName="Label" Property="Text" Value="Gestreept" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:LineDash.Dot}">
                    <Setter TargetName="Sample" Property="StrokeDashArray" Value="0 2" />
                    <Setter TargetName="Sample" Property="StrokeDashCap" Value="Round" />
                    <Setter TargetName="Sample" Property="X1" Value="2" />
                    <Setter TargetName="Label" Property="Text" Value="Gestippeld" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Sample" Property="Width" Value="28" />
                    <Setter TargetName="Sample" Property="X2" Value="27" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Hoeken: hoekje met de gekozen afronding -->
        <DataTemplate x:Key="CornerTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" VerticalAlignment="Center" ClipToBounds="True">
                    <Border Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                            BorderBrush="{DynamicResource InkBrush}" BorderThickness="2,2,0,0"
                            CornerRadius="{Binding Converter={StaticResource CornerPreview}}" />
                </Grid>
                <TextBlock x:Name="Label" Text="{Binding StringFormat={}{0} px}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="0">
                    <Setter TargetName="Label" Property="Text" Value="Recht" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Lettergrootte: "A" met het getal -->
        <DataTemplate x:Key="FontSizeTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="A" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" FontSize="11" Margin="3,4,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- Grootte (stappen, cursor): cirkel met het getal -->
        <DataTemplate x:Key="SizeTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                    <Path Data="M5,8 H11 M8,5 V11" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                </Grid>
                <TextBlock Text="{Binding}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- Stappenreeks: badge met het eerste teken -->
        <DataTemplate x:Key="NumberingTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Fill="#E81123" />
                    <TextBlock x:Name="Badge" Text="1" Foreground="White" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="Label" Text="1, 2, 3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:StepNumbering.LowerAlpha}">
                    <Setter TargetName="Badge" Property="Text" Value="a" />
                    <Setter TargetName="Label" Property="Text" Value="a, b, c" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:StepNumbering.UpperAlpha}">
                    <Setter TargetName="Badge" Property="Text" Value="A" />
                    <Setter TargetName="Label" Property="Text" Value="A, B, C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:StepNumbering.Roman}">
                    <Setter TargetName="Badge" Property="Text" Value="I" />
                    <Setter TargetName="Label" Property="Text" Value="I, II, III" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Soort cursor: het cursoricoon zelf -->
        <DataTemplate x:Key="CursorKindTemplate">
            <StackPanel Orientation="Horizontal">
                <Path Data="{Binding Converter={StaticResource CursorIcon}}" Fill="{DynamicResource ControlBrush}" Stroke="{DynamicResource InkBrush}"
                      StrokeThickness="1" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Text="Pijl" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:CursorKind.Click}">
                    <Setter TargetName="Label" Property="Text" Value="Pijl met klik" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:CursorKind.Hand}">
                    <Setter TargetName="Label" Property="Text" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Vorm van een tekstobject: geen kader, kader, ballon, ovaal of wolk -->
        <DataTemplate x:Key="TextShapeTemplate">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="Icon" Data="M2.5,3.5 H17.5 V14.5 H2.5 Z" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      Width="20" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Text="Kader" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:TextShape.None}">
                    <Setter TargetName="Icon" Property="Data" Value="M5,4 H15 M10,4 V15" />
                    <Setter TargetName="Label" Property="Text" Value="Geen kader" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:TextShape.Balloon}">
                    <Setter TargetName="Icon" Property="Data" Value="M4,2.5 H16 Q17.5,2.5 17.5,4 V11 Q17.5,12.5 16,12.5 H9 L4.5,16.5 L6,12.5 H4 Q2.5,12.5 2.5,11 V4 Q2.5,2.5 4,2.5 Z" />
                    <Setter TargetName="Label" Property="Text" Value="Ballon" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:TextShape.Oval}">
                    <Setter TargetName="Icon" Property="Data" Value="M10,2 C14.7,2 18,4.5 18,7.5 C18,10.5 14.7,13 10,13 C9,13 8.1,12.9 7.3,12.7 L3.8,16.5 L4.8,12 C3,11 2,9.4 2,7.5 C2,4.5 5.3,2 10,2 Z" />
                    <Setter TargetName="Label" Property="Text" Value="Ovale ballon" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:TextShape.Cloud}">
                    <Setter TargetName="Icon" Property="Data" Value="M6.5,12 A2.8,2.8 0 0 1 4.2,6.8 A3.3,3.3 0 0 1 9.2,3.6 A3.3,3.3 0 0 1 15,4.8 A2.8,2.8 0 0 1 16.2,10.5 A2.8,2.8 0 0 1 12,12.2 A3,3 0 0 1 6.5,12 Z M3.8,14.6 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0 Z M1.8,17 a0.7,0.7 0 1 0 1.4,0 a0.7,0.7 0 1 0 -1.4,0 Z" />
                    <Setter TargetName="Label" Property="Text" Value="Wolk" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Vorm van het vormengereedschap -->
        <DataTemplate x:Key="ShapeKindTemplate">
            <StackPanel Orientation="Horizontal">
                <Path Data="{Binding Converter={StaticResource ShapeIcon}}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2"
                      StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" Margin="2,1" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Text="Driehoek" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.BlockArrow}">
                    <Setter TargetName="Label" Property="Text" Value="Pijl" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Star}">
                    <Setter TargetName="Label" Property="Text" Value="Ster" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Cloud}">
                    <Setter TargetName="Label" Property="Text" Value="Wolk" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Balloon}">
                    <Setter TargetName="Label" Property="Text" Value="Ballon" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Heart}">
                    <Setter TargetName="Label" Property="Text" Value="Hart" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Moon}">
                    <Setter TargetName="Label" Property="Text" Value="Maan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Drop}">
                    <Setter TargetName="Label" Property="Text" Value="Druppel" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Egg}">
                    <Setter TargetName="Label" Property="Text" Value="Ei" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Lightning}">
                    <Setter TargetName="Label" Property="Text" Value="Bliksemschicht" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:ShapeKind.Spiral}">
                    <Setter TargetName="Label" Property="Text" Value="Spiraal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Aantal rondjes in de staart van een wolk; 0 = automatisch -->
        <DataTemplate x:Key="CloudBubblesTemplate">
            <StackPanel Orientation="Horizontal">
                <Path Data="M13.5,4.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z M7.5,10 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 Z M2.5,15 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0 Z"
                      Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" Width="20" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Text="{Binding}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}">
                    <DataTrigger.Value>
                        <sys:Int32>0</sys:Int32>
                    </DataTrigger.Value>
                    <Setter TargetName="Label" Property="Text" Value="Auto" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Effect: pixelblokjes of zachte vlek -->
        <DataTemplate x:Key="BlurModeTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Path x:Name="PixelIcon" Fill="{DynamicResource InkBrush}"
                          Data="M1,1 h4.5 v4.5 h-4.5 z M10.5,1 h4.5 v4.5 h-4.5 z M5.75,5.75 h4.5 v4.5 h-4.5 z M1,10.5 h4.5 v4.5 h-4.5 z M10.5,10.5 h4.5 v4.5 h-4.5 z" />
                    <Ellipse x:Name="BlurIcon" Visibility="Collapsed" Fill="{DynamicResource InkBrush}">
                        <Ellipse.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0" />
                                <GradientStop Color="#80000000" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.OpacityMask>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="Label" Text="Pixeleren" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:BlurMode.Blur}">
                    <Setter TargetName="PixelIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BlurIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Text" Value="Vervagen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DrawingBrush x:Key="CheckerIcon" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#E4E4E4" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Achtergrond van het canvas: geen, kleur, verloop of afbeelding -->
        <DataTemplate x:Key="BackgroundKindTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Border x:Name="Swatch" CornerRadius="3" BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1"
                            Background="{StaticResource CheckerIcon}" />
                    <TextBlock x:Name="ImageIcon" Text="&#xE91B;" Style="{StaticResource IconText}" FontSize="15" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="Label" Text="Geen (transparant)" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:BackgroundKind.Color}">
                    <Setter TargetName="Swatch" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Label" Property="Text" Value="Kleur" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:BackgroundKind.Gradient}">
                    <Setter TargetName="Swatch" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#0078D4" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Label" Property="Text" Value="Verloop" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static local:BackgroundKind.Image}">
                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ImageIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Text" Value="Afbeelding" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- Statusbalk -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" />
                <TextBlock x:Name="HintText" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Onderste werkbalk in de gesplitste indeling; de code verplaatst de acties hierheen -->
        <Border x:Name="ActionBar" DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="8,6" Visibility="Collapsed"
                SizeChanged="Toolbar_SizeChanged" ContextMenuOpening="Toolbar_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="ActionBarMenu" />
            </Border.ContextMenu>
            <local:ToolbarPanel x:Name="ActionItems" OrderChanged="ToolbarItems_OrderChanged" />
        </Border>

        <!-- Gereedschappen en acties; rechtsklik voor vergrendelen, positie en zichtbare knoppen -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1" Padding="8,6" SizeChanged="Toolbar_SizeChanged" ContextMenuOpening="Toolbar_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="ToolbarMenu" />
            </Border.ContextMenu>
            <local:ToolbarPanel x:Name="ToolbarItems" OrderChanged="ToolbarItems_OrderChanged">
                <RadioButton GroupName="Tools" Tag="Select" local:ToolbarPanel.ItemId="Select" local:ToolbarPanel.Title="Selecteren"
                             Style="{StaticResource ToolToggle}" ToolTip="Selecteren en verplaatsen (V)" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Data="M5,2.5 L5,16.5 L8.6,13.2 L11,18.4 L13.3,17.4 L11,12.3 L15.8,12.3 Z" />
                </RadioButton>
                <local:ToolbarSeparator local:ToolbarPanel.ItemId="Sep1" />
                <RadioButton GroupName="Tools" Tag="Rectangle" local:ToolbarPanel.ItemId="Rectangle" local:ToolbarPanel.Title="Rechthoek"
                             Style="{StaticResource ToolToggle}" ToolTip="Rechthoek (R) - Shift voor vierkant" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Data="M3,5 H17 V15 H3 Z" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Ellipse" local:ToolbarPanel.ItemId="Ellipse" local:ToolbarPanel.Title="Ellips"
                             Style="{StaticResource ToolToggle}" ToolTip="Ellips (E) - Shift voor cirkel" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}">
                        <Path.Data>
                            <EllipseGeometry Center="10,10" RadiusX="7.5" RadiusY="5.5" />
                        </Path.Data>
                    </Path>
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Shape" local:ToolbarPanel.ItemId="Shape" local:ToolbarPanel.Title="Vormen"
                             Style="{StaticResource ToolToggle}" ToolTip="Vormen (F) - Shift voor gelijke breedte en hoogte" Checked="Tool_Checked">
                    <Path x:Name="ShapeToolIcon" Style="{StaticResource IconPath}" Stretch="Uniform" Width="15" Height="15" Margin="2.5" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Line" local:ToolbarPanel.ItemId="Line" local:ToolbarPanel.Title="Lijn"
                             Style="{StaticResource ToolToggle}" ToolTip="Lijn (L) - Shift voor hoeken van 45°" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Data="M4,16 L16,4" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Arrow" local:ToolbarPanel.ItemId="Arrow" local:ToolbarPanel.Title="Pijl"
                             Style="{StaticResource ToolToggle}" ToolTip="Pijl (A) - Shift voor hoeken van 45°" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Data="M4,16 L15.5,4.5 M9,4.5 H15.5 V11" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Text" local:ToolbarPanel.ItemId="Text" local:ToolbarPanel.Title="Tekst"
                             Style="{StaticResource ToolToggle}" ToolTip="Tekst in kader (T)" Checked="Tool_Checked">
                    <Grid Width="20" Height="20">
                        <Path Style="{StaticResource IconPath}" Data="M2.5,4 H17.5 V16 H2.5 Z" />
                        <TextBlock Text="T" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Grid>
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Step" local:ToolbarPanel.ItemId="Step" local:ToolbarPanel.Title="Stappen"
                             Style="{StaticResource ToolToggle}" ToolTip="Stappen 1, 2, 3 / a, b, c (S)" Checked="Tool_Checked">
                    <Grid Width="20" Height="20">
                        <Ellipse Width="17" Height="17" Fill="#E81123" />
                        <TextBlock Text="1" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Cursor" local:ToolbarPanel.ItemId="Cursor" local:ToolbarPanel.Title="Cursor"
                             Style="{StaticResource ToolToggle}" ToolTip="Cursor plaatsen (C)" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Fill="{DynamicResource ControlBrush}"
                          Data="M7,4 L7,16 L9.8,13.4 L11.7,17.6 L13.6,16.8 L11.8,12.6 L15.4,12.6 Z M4,4 L2.5,2.5 M7,1 L7,0 M4,7 L2,7" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Emoji" local:ToolbarPanel.ItemId="Emoji" local:ToolbarPanel.Title="Emoji"
                             Style="{StaticResource ToolToggle}" ToolTip="Emoji plaatsen (J)" Checked="Tool_Checked">
                    <TextBlock Text="&#xE76E;" Style="{StaticResource IconText}" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Highlight" local:ToolbarPanel.ItemId="Highlight" local:ToolbarPanel.Title="Markeerstift"
                             Style="{StaticResource ToolToggle}" ToolTip="Markeerstift (H) - rechte horizontale streep, Shift wisselt" Checked="Tool_Checked">
                    <Grid Width="20" Height="20">
                        <Rectangle Width="17" Height="7" Fill="#A0FFE600" VerticalAlignment="Center" />
                        <Path Style="{StaticResource IconPath}" Data="M2,10 H18" StrokeThickness="1" Stroke="#B39C00" Opacity="0.6" />
                    </Grid>
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Blur" local:ToolbarPanel.ItemId="Blur" local:ToolbarPanel.Title="Vervagen / pixeleren"
                             Style="{StaticResource ToolToggle}" ToolTip="Vervagen / pixeleren (B)" Checked="Tool_Checked">
                    <Path Style="{StaticResource IconPath}" Fill="{DynamicResource InkBrush}" StrokeThickness="0"
                          Data="M3,3 h4.5 v4.5 h-4.5 z M12.5,3 h4.5 v4.5 h-4.5 z M7.75,7.75 h4.5 v4.5 h-4.5 z M3,12.5 h4.5 v4.5 h-4.5 z M12.5,12.5 h4.5 v4.5 h-4.5 z" />
                </RadioButton>
                <RadioButton GroupName="Tools" Tag="Eraser" local:ToolbarPanel.ItemId="Eraser" local:ToolbarPanel.Title="Gum"
                             Style="{StaticResource ToolToggle}" ToolTip="Gum (G) - smart-gum haalt aaneengesloten dezelfde kleur weg; kies in de balk eronder voor vrije hand" Checked="Tool_Checked">
                    <Grid Width="20" Height="20">
                        <TextBlock Text="&#xE75C;" Style="{StaticResource IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Data="M3.5,0 L4.4,2.6 L7,3.5 L4.4,4.4 L3.5,7 L2.6,4.4 L0,3.5 L2.6,2.6 Z" />
                    </Grid>
                </RadioButton>
                <local:ToolbarSeparator local:ToolbarPanel.ItemId="Sep2" />
                <RadioButton GroupName="Tools" Tag="Crop" local:ToolbarPanel.ItemId="Crop" local:ToolbarPanel.Title="Bijsnijden"
                             Style="{StaticResource ToolToggle}" ToolTip="Bijsnijden (X)" Checked="Tool_Checked">
                    <TextBlock Text="&#xE7A8;" Style="{StaticResource IconText}" />
                </RadioButton>

                <local:ToolbarSpacer local:ToolbarPanel.ItemId="Spacer" />

                <Button local:ToolbarPanel.ItemId="New" local:ToolbarPanel.Title="Nieuw knipsel"
                        Style="{StaticResource ProminentButton}" ToolTip="Nieuw knipsel maken; dat opent in een nieuw tabblad (Ctrl+N)" Click="NewSnip_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" Style="{StaticResource IconText}" />
                        <TextBlock x:Name="NewLabel" Text="Nieuw" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button local:ToolbarPanel.ItemId="Screencast" local:ToolbarPanel.Title="Screencast"
                        Style="{StaticResource ProminentButton}" ToolTip="Screencast opnemen als MP4 of GIF" Click="Screencast_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" />
                        <TextBlock x:Name="ScreencastLabel" Text="Screencast" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="OcrButton" local:ToolbarPanel.ItemId="OcrSnip" local:ToolbarPanel.Title="OCR"
                        Style="{StaticResource ProminentButton}" Click="Ocr_Click"
                        ToolTip="OCR: sleep een rechthoek op het scherm en kopieer de tekst daarin. Ctrl+Shift+T leest de tekst van dit knipsel.">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" StrokeThickness="1.2"
                              Data="M3,7 V5.5 A2.5,2.5 0 0 1 5.5,3 H7 M13,3 H14.5 A2.5,2.5 0 0 1 17,5.5 V7 M17,13 V14.5 A2.5,2.5 0 0 1 14.5,17 H13 M7,17 H5.5 A2.5,2.5 0 0 1 3,14.5 V13 M7,7.5 H13 M7,10 H13 M7,12.5 H10.5" />
                        <TextBlock x:Name="OcrLabel" Text="OCR" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- Wat tussen de twee spacers staat, komt in het midden van de werkbalk -->
                <local:ToolbarSpacer local:ToolbarPanel.ItemId="Spacer2" />

                <Button local:ToolbarPanel.ItemId="Clear" local:ToolbarPanel.Title="Wissen"
                        Style="{StaticResource FlatButton}" ToolTip="Knipsel weggooien en opnieuw beginnen met een leeg canvas (Ctrl+Delete)" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE894;" Style="{StaticResource IconText}" />
                        <TextBlock x:Name="ClearLabel" Text="Wissen" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <local:ToolbarSeparator local:ToolbarPanel.ItemId="Sep3" />
                <Button x:Name="UndoButton" local:ToolbarPanel.ItemId="Undo" local:ToolbarPanel.Title="Ongedaan maken"
                        Style="{StaticResource FlatButton}" ToolTip="Ongedaan maken (Ctrl+Z)" Click="Undo_Click">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" />
                </Button>
                <Button x:Name="RedoButton" local:ToolbarPanel.ItemId="Redo" local:ToolbarPanel.Title="Opnieuw"
                        Style="{StaticResource FlatButton}" ToolTip="Opnieuw (Ctrl+Y)" Click="Redo_Click">
                    <TextBlock Text="&#xE7A6;" Style="{StaticResource IconText}" />
                </Button>
                <Button x:Name="DeleteButton" local:ToolbarPanel.ItemId="Delete" local:ToolbarPanel.Title="Verwijderen"
                        Style="{StaticResource FlatButton}" ToolTip="Geselecteerd object verwijderen (Delete)" Click="Delete_Click">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                </Button>
                <local:ToolbarSeparator local:ToolbarPanel.ItemId="Sep4" />
                <ToggleButton x:Name="RulersToggle" local:ToolbarPanel.ItemId="Rulers" local:ToolbarPanel.Title="Linialen"
                              Style="{StaticResource ToolToggle}" ToolTip="Linialen en hulplijnen (Ctrl+R) - sleep vanuit een liniaal voor een hulplijn"
                              Click="Rulers_Click">
                    <Path Style="{StaticResource IconPath}"
                          Data="M2.5,6.5 H17.5 V13.5 H2.5 Z M5,6.5 V9 M7.5,6.5 V10.5 M10,6.5 V9 M12.5,6.5 V10.5 M15,6.5 V9" />
                </ToggleButton>
                <Button local:ToolbarPanel.ItemId="ZoomOut" local:ToolbarPanel.Title="Uitzoomen"
                        Style="{StaticResource FlatButton}" ToolTip="Uitzoomen (Ctrl+-)" Click="ZoomOut_Click">
                    <TextBlock Text="&#xE71F;" Style="{StaticResource IconText}" />
                </Button>
                <Button x:Name="ZoomButton" local:ToolbarPanel.ItemId="Zoom" local:ToolbarPanel.Title="Zoompercentage"
                        Style="{StaticResource FlatButton}" ToolTip="Passend maken (Ctrl+0) / werkelijke grootte (Ctrl+1)" Click="ZoomReset_Click" MinWidth="56">
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" />
                </Button>
                <Button local:ToolbarPanel.ItemId="ZoomIn" local:ToolbarPanel.Title="Inzoomen"
                        Style="{StaticResource FlatButton}" ToolTip="Inzoomen (Ctrl++)" Click="ZoomIn_Click">
                    <TextBlock Text="&#xE8A3;" Style="{StaticResource IconText}" />
                </Button>
                <local:ToolbarSeparator local:ToolbarPanel.ItemId="Sep5" />
                <Button x:Name="FoldersButton" local:ToolbarPanel.ItemId="Folders" local:ToolbarPanel.Title="Mappen openen"
                        Style="{StaticResource FlatButton}" ToolTip="Screenshot- of screencastmap openen" Click="Folders_Click">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" />
                </Button>
                <Button local:ToolbarPanel.ItemId="Print" local:ToolbarPanel.Title="Printen"
                        Style="{StaticResource FlatButton}" ToolTip="Printen (Ctrl+P)" Click="Print_Click">
                    <TextBlock Text="&#xE749;" Style="{StaticResource IconText}" />
                </Button>
                <Button x:Name="SettingsButton" local:ToolbarPanel.ItemId="Settings" local:ToolbarPanel.Title="Instellingen"
                        Style="{StaticResource FlatButton}" ToolTip="Instellingen" Click="Settings_Click">
                    <Grid>
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" />
                        <Ellipse x:Name="SettingsBadge" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource ToolbarBrush}"
                                 StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                 IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="SaveButton" local:ToolbarPanel.ItemId="Save" local:ToolbarPanel.Title="Opslaan"
                        Style="{StaticResource SecondaryButton}" ToolTip="Opslaan (Ctrl+S); Shift+klik of Ctrl+Shift+S = opslaan als; het pijltje toont meer opties" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="14" />
                        <TextBlock x:Name="SaveLabel" Text="Opslaan" Margin="6,0,0,0" />
                        <TextBlock x:Name="SaveMenuChevron" Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9"
                                   Background="Transparent" Padding="4,2,0,2" Margin="2,0,0,0"
                                   ToolTip="Meer opslagopties" PreviewMouseLeftButtonDown="SaveMenu_MouseDown" />
                    </StackPanel>
                </Button>
                <Button x:Name="UploadButton" local:ToolbarPanel.ItemId="Upload" local:ToolbarPanel.Title="Uploaden"
                        Style="{StaticResource SecondaryButton}" ToolTip="Uploaden en de link kopiëren (Ctrl+U)" Click="Upload_Click" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" FontSize="14" />
                        <TextBlock x:Name="UploadLabel" Text="Uploaden" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button local:ToolbarPanel.ItemId="Copy" local:ToolbarPanel.Title="Kopiëren"
                        Style="{StaticResource AccentButton}" ToolTip="Kopiëren naar klembord (Ctrl+C)" Click="Copy_Click" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" Foreground="White" />
                        <TextBlock x:Name="CopyLabel" Text="Kopiëren" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- Alleen in de gesplitste indeling: gereedschappen in het midden, Instellingen rechts -->
                <local:ToolbarSpacer local:ToolbarPanel.ItemId="SplitSpacer1" />
                <local:ToolbarSpacer local:ToolbarPanel.ItemId="SplitSpacer2" />
            </local:ToolbarPanel>
        </Border>

        <!-- Eigenschappen van het actieve gereedschap of het geselecteerde object -->
        <Border x:Name="PropsBar" DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,4" MinHeight="42">
            <WrapPanel x:Name="PropsPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel x:Name="ShapeGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="ShapeKindCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource ShapeKindTemplate}"
                              ToolTip="Vorm" SelectionChanged="ShapeKind_Changed" />
                </StackPanel>
                <StackPanel x:Name="TextShapeGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="TextShapeCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource TextShapeTemplate}"
                              ToolTip="Vorm" SelectionChanged="TextShape_Changed" />
                    <ComboBox x:Name="CloudBubblesCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource CloudBubblesTemplate}"
                              ToolTip="Aantal bolletjes naar de punt" SelectionChanged="CloudBubbles_Changed" />
                </StackPanel>
                <StackPanel x:Name="StrokeGroup" Style="{StaticResource PropGroup}">
                    <local:ColorPickerButton x:Name="StrokePicker" ShowAsOutline="True" ToolTip="Randkleur" />
                </StackPanel>
                <StackPanel x:Name="FillGroup" Style="{StaticResource PropGroup}">
                    <local:ColorPickerButton x:Name="FillPicker" AllowTransparent="True" ToolTip="Vulkleur" />
                </StackPanel>
                <StackPanel x:Name="ForegroundGroup" Style="{StaticResource PropGroup}">
                    <local:ColorPickerButton x:Name="ForegroundPicker" ShowAsText="True" ToolTip="Tekstkleur" />
                </StackPanel>
                <StackPanel x:Name="ThicknessGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="ThicknessCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource ThicknessTemplate}"
                              ToolTip="Dikte" SelectionChanged="Thickness_Changed" />
                </StackPanel>
                <StackPanel x:Name="DashGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="DashCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource DashTemplate}"
                              ToolTip="Lijnstijl" SelectionChanged="Dash_Changed" />
                </StackPanel>
                <StackPanel x:Name="CornerGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="CornerCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource CornerTemplate}"
                              ToolTip="Hoeken" SelectionChanged="Corner_Changed" />
                </StackPanel>
                <StackPanel x:Name="FontGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="FontSizeCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource FontSizeTemplate}"
                              ToolTip="Lettergrootte" SelectionChanged="FontSize_Changed" />
                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource MiniToggle}" ToolTip="Vet" Checked="Bold_Changed" Unchecked="Bold_Changed">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextAlignLeftToggle" Style="{StaticResource MiniToggle}" ToolTip="Tekst links uitlijnen" Click="TextAlign_Click">
                        <TextBlock Text="&#xE8E4;" Style="{StaticResource IconText}" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextAlignCenterToggle" Style="{StaticResource MiniToggle}" ToolTip="Tekst centreren" Click="TextAlign_Click">
                        <TextBlock Text="&#xE8E3;" Style="{StaticResource IconText}" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextAlignRightToggle" Style="{StaticResource MiniToggle}" ToolTip="Tekst rechts uitlijnen" Click="TextAlign_Click">
                        <TextBlock Text="&#xE8E2;" Style="{StaticResource IconText}" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="NumberingGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="NumberingCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource NumberingTemplate}"
                              ToolTip="Reeks" SelectionChanged="Numbering_Changed" />
                </StackPanel>
                <StackPanel x:Name="CursorGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="CursorKindCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource CursorKindTemplate}"
                              ToolTip="Soort cursor" SelectionChanged="CursorKind_Changed" />
                </StackPanel>
                <StackPanel x:Name="EmojiGroup" Style="{StaticResource PropGroup}">
                    <local:EmojiPickerButton x:Name="EmojiPicker" />
                </StackPanel>
                <StackPanel x:Name="SizeGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="SizeCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource SizeTemplate}"
                              ToolTip="Grootte" SelectionChanged="Size_Changed" />
                </StackPanel>
                <StackPanel x:Name="BlurGroup" Style="{StaticResource PropGroup}">
                    <ComboBox x:Name="BlurModeCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource BlurModeTemplate}"
                              ToolTip="Effect" SelectionChanged="BlurMode_Changed" />
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Height="30" Margin="2,0" Padding="8,0"
                            ToolTip="Sterkte">
                        <Slider x:Name="BlurStrengthSlider" Width="90" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="BlurStrength_Changed" />
                    </Border>
                </StackPanel>
                <StackPanel x:Name="EraserModeGroup" Style="{StaticResource PropGroup}">
                    <ToggleButton x:Name="EraserSmartToggle" Style="{StaticResource MiniToggle}" ToolTip="Smart-gum: klik op een kleur om alle aangrenzende pixels met die kleur weg te halen"
                                  Click="EraserMode_Click">
                        <Grid Width="20" Height="20">
                            <TextBlock Text="&#xE75C;" Style="{StaticResource IconText}" FontSize="14" />
                            <Path Fill="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Data="M3.5,0 L4.4,2.6 L7,3.5 L4.4,4.4 L3.5,7 L2.6,4.4 L0,3.5 L2.6,2.6 Z" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="EraserBrushToggle" Style="{StaticResource MiniToggle}" ToolTip="Vrije hand: sleep om weg te poetsen"
                                  Click="EraserMode_Click">
                        <TextBlock Text="&#xE75C;" Style="{StaticResource IconText}" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="ToleranceGroup" Style="{StaticResource PropGroup}">
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Height="30" Margin="2,0" Padding="8,0"
                            ToolTip="Tolerantie: hoe ver een kleur mag afwijken om mee weggehaald te worden">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tolerantie" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="ToleranceSlider" Width="90" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="Tolerance_Changed" />
                            <TextBlock x:Name="ToleranceText" FontSize="12" Width="24" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="StraightGroup" Style="{StaticResource PropGroup}">
                    <ToggleButton x:Name="StraightCheck" Style="{StaticResource MiniToggle}" ToolTip="Rechte horizontale streep (Shift wisselt)"
                                  Checked="Straight_Changed" Unchecked="Straight_Changed">
                        <Path Data="M2,9 H16 M2,5 V13 M16,5 V13" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="ShadowGroup" Style="{StaticResource PropGroup}">
                    <ToggleButton x:Name="ShadowCheck" Style="{StaticResource MiniToggle}" ToolTip="Schaduw"
                                  Checked="Shadow_Changed" Unchecked="Shadow_Changed">
                        <Grid Width="18" Height="18">
                            <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="#9A9A9A" Margin="5,5,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{DynamicResource ControlBrush}" Stroke="{DynamicResource InkBrush}"
                                       StrokeThickness="1" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="ArrangeGroup" Style="{StaticResource PropGroup}">
                    <Rectangle Style="{StaticResource ArrangeDivider}" />
                    <ToggleButton x:Name="ArrangeToggle" Style="{StaticResource MiniToggle}" ToolTip="Uitlijnen, spiegelen en volgorde"
                                  Checked="ArrangeToggle_Changed" Unchecked="ArrangeToggle_Changed">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5.5,5 H15 V8.5 H5.5 Z M5.5,11.5 H11.5 V15 H5.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M3,2.5 V17.5" />
                            </Grid>
                            <TextBlock x:Name="ArrangeChevron" Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="10" Margin="4,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel x:Name="ArrangeButtons" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Links uitlijnen op de afbeelding" Click="AlignLeft_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5.5,5 H15 V8.5 H5.5 Z M5.5,11.5 H11.5 V15 H5.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M3,2.5 V17.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Horizontaal centreren op de afbeelding" Click="AlignCenter_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M4.5,5 H15.5 V8.5 H4.5 Z M6.5,11.5 H13.5 V15 H6.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M10,2.5 V17.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Rechts uitlijnen op de afbeelding" Click="AlignRight_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5,5 H14.5 V8.5 H5 Z M8.5,11.5 H14.5 V15 H8.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M17,2.5 V17.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Boven uitlijnen op de afbeelding" Click="AlignTop_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5,5.5 H8.5 V15 H5 Z M11.5,5.5 H15 V11.5 H11.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M2.5,3 H17.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Verticaal centreren op de afbeelding" Click="AlignMiddle_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5,4.5 H8.5 V15.5 H5 Z M11.5,6.5 H15 V13.5 H11.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M2.5,10 H17.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ArrangeButton}" ToolTip="Onder uitlijnen op de afbeelding" Click="AlignBottom_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M5,5 H8.5 V14.5 H5 Z M11.5,8.5 H15 V14.5 H11.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M2.5,17 H17.5" />
                            </Grid>
                        </Button>
                        <Rectangle Style="{StaticResource ArrangeDivider}" />
                        <Button x:Name="FlipHButton" Style="{StaticResource ArrangeButton}" ToolTip="Horizontaal spiegelen" Click="FlipH_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Fill="{DynamicResource InkBrush}" Data="M8,5 L3,15 H8 Z" />
                                <Path Style="{StaticResource IconPath}" Data="M12,5 L17,15 H12 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M10,2.5 V17.5" />
                            </Grid>
                        </Button>
                        <Button x:Name="FlipVButton" Style="{StaticResource ArrangeButton}" ToolTip="Verticaal spiegelen" Click="FlipV_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Fill="{DynamicResource InkBrush}" Data="M5,8 L15,3 V8 Z" />
                                <Path Style="{StaticResource IconPath}" Data="M5,12 L15,17 V12 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M2.5,10 H17.5" />
                            </Grid>
                        </Button>
                        <Button x:Name="RotateLeftButton" Style="{StaticResource ArrangeButton}" ToolTip="90° linksom draaien" Click="RotateLeft_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M8.5,8.5 H15.5 V15.5 H8.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M3.5,11 A6.5,6.5 0 0 1 10,4.5 M3.5,11 L1.8,8.6 M3.5,11 L5.9,9.4" />
                            </Grid>
                        </Button>
                        <Button x:Name="RotateRightButton" Style="{StaticResource ArrangeButton}" ToolTip="90° rechtsom draaien (sleep de ronde greep boven het object om vrij te draaien)" Click="RotateRight_Click">
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M4.5,8.5 H11.5 V15.5 H4.5 Z" />
                                <Path Style="{StaticResource ArrangeAccent}" Data="M16.5,11 A6.5,6.5 0 0 0 10,4.5 M16.5,11 L18.2,8.6 M16.5,11 L14.1,9.4" />
                            </Grid>
                        </Button>
                        <Rectangle Style="{StaticResource ArrangeDivider}" />
                        <Button x:Name="ForwardButton" Style="{StaticResource ArrangeButton}" ToolTip="Naar voren (PageUp)" Click="BringForward_Click">
                            <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" />
                        </Button>
                        <Button x:Name="BackwardButton" Style="{StaticResource ArrangeButton}" ToolTip="Naar achteren (PageDown)" Click="SendBackward_Click">
                            <TextBlock Text="&#xE74B;" Style="{StaticResource IconText}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="NoPropsText" Style="{StaticResource PropLabel}" VerticalAlignment="Center" />
                <StackPanel x:Name="BackgroundGroup" Style="{StaticResource PropGroup}">
                    <Rectangle Style="{StaticResource ArrangeDivider}" />
                    <TextBlock Text="Achtergrond" Style="{StaticResource PropLabel}" Margin="4,0,4,0" />
                    <ComboBox x:Name="BackgroundKindCombo" Style="{StaticResource MiniCombo}" ItemTemplate="{StaticResource BackgroundKindTemplate}"
                              ToolTip="Achtergrond onder de transparante delen" SelectionChanged="BackgroundKind_Changed" />
                    <local:ColorPickerButton x:Name="BackgroundColorPicker" ToolTip="Kleur" />
                    <local:ColorPickerButton x:Name="BackgroundColor2Picker" ToolTip="Tweede kleur van het verloop" />
                    <local:GradientAngleDial x:Name="GradientDial" Margin="2,0" />
                    <Button x:Name="BackgroundImageButton" Style="{StaticResource FlatButton}" Padding="6,4" MinWidth="0" MinHeight="30" Margin="2,0"
                            BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBrush}"
                            ToolTip="Afbeelding kiezen; die vult het hele canvas" Click="BackgroundImage_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20">
                                <TextBlock x:Name="BackgroundImageIcon" Text="&#xE91B;" Style="{StaticResource IconText}" />
                                <Image x:Name="BackgroundImageThumb" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,20,20" RadiusX="3" RadiusY="3" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                            <TextBlock Text="Kiezen..." FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Extra balk in de drie-split-indeling, aan een kant van het canvas; de code verplaatst Nieuw en Screencast hierheen -->
        <Border x:Name="CaptureBar" DockPanel.Dock="Left" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0" Padding="6,8" Visibility="Collapsed"
                SizeChanged="Toolbar_SizeChanged" ContextMenuOpening="Toolbar_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="CaptureBarMenu" />
            </Border.ContextMenu>
            <local:ToolbarPanel x:Name="CaptureItems" Orientation="Vertical" OrderChanged="ToolbarItems_OrderChanged" />
        </Border>

        <!-- Canvas met linialen; sleep vanuit een liniaal om een hulplijn te maken -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border x:Name="RulerCorner" Width="20" Height="20" Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1"
                    MouseRightButtonUp="RulerCorner_MouseRightButtonUp">
                <Button x:Name="RulerFolderButton" Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="0" Margin="0"
                        Padding="0" BorderThickness="0" ToolTip="Map openen (rechtsklik: hulplijnen wissen)" Click="RulerFolder_Click">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="12" />
                </Button>
            </Border>
            <local:RulerControl x:Name="HRuler" Grid.Column="1" Height="20" Orientation="Horizontal"
                                Background="{DynamicResource ToolbarBrush}" ImageBackground="{DynamicResource CardBrush}"
                                Foreground="{DynamicResource SubtleTextBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                Cursor="SizeNS" MouseLeftButtonDown="Ruler_MouseLeftButtonDown" MouseMove="Ruler_MouseMove"
                                MouseLeftButtonUp="Ruler_MouseLeftButtonUp" LostMouseCapture="Ruler_LostMouseCapture" />
            <local:RulerControl x:Name="VRuler" Grid.Row="1" Width="20" Orientation="Vertical"
                                Background="{DynamicResource ToolbarBrush}" ImageBackground="{DynamicResource CardBrush}"
                                Foreground="{DynamicResource SubtleTextBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                Cursor="SizeWE" MouseLeftButtonDown="Ruler_MouseLeftButtonDown" MouseMove="Ruler_MouseMove"
                                MouseLeftButtonUp="Ruler_MouseLeftButtonUp" LostMouseCapture="Ruler_LostMouseCapture" />
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CanvasBrush}" PreviewMouseWheel="Scroller_PreviewMouseWheel" Focusable="False">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <Border BorderBrush="{DynamicResource CanvasBorderBrush}" BorderThickness="1" Margin="-1" SnapsToDevicePixels="True" />
                    <Grid x:Name="CanvasHost" LayoutUpdated="CanvasHost_LayoutUpdated">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" />
                        </Grid.LayoutTransform>
                        <local:AnnotationSurface x:Name="Surface"
                                                 MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                                                 MouseMove="Surface_MouseMove"
                                                 MouseLeave="Surface_MouseLeave"
                                                 MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                                                 MouseRightButtonUp="Surface_MouseRightButtonUp"
                                                 LostMouseCapture="Surface_LostMouseCapture" />
                        <Canvas x:Name="TextLayer" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Zwevende Nieuw en Screencast (drie-split); versleep aan de rand of het greepje -->
            <Canvas x:Name="FloatLayer" Grid.Row="1" Grid.Column="1" ClipToBounds="True" SizeChanged="FloatLayer_SizeChanged">
                <Border x:Name="CaptureFloat" Visibility="Collapsed" Background="{DynamicResource ToolbarBrush}"
                        BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,2,4,4"
                        SizeChanged="FloatLayer_SizeChanged" ContextMenuOpening="Toolbar_ContextMenuOpening"
                        MouseLeftButtonDown="CaptureFloat_MouseLeftButtonDown" MouseMove="CaptureFloat_MouseMove"
                        MouseLeftButtonUp="CaptureFloat_MouseLeftButtonUp" LostMouseCapture="CaptureFloat_LostMouseCapture">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                    </Border.Effect>
                    <Border.ContextMenu>
                        <ContextMenu x:Name="CaptureFloatMenu" />
                    </Border.ContextMenu>
                    <StackPanel x:Name="CaptureFloatPanel">
                        <TextBlock x:Name="CaptureFloatGrip" Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" Background="Transparent" Padding="0,2" Cursor="SizeAll"
                                   ToolTip="Slepen om te verplaatsen; rechtsklik om vast te zetten" />
                        <Border x:Name="CaptureFloatHost" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</UserControl>
