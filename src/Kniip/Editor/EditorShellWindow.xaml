<Window x:Class="Kniip.Editor.EditorShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Kniip.Editor"
        Title="kniip" Width="1180" Height="780" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Icon="pack://application:,,,/AppIcon.ico">
    <!-- Eigen titelbalk zoals in een browser: de tabkoppen staan in de balk, lege ruimte ertussen sleept het venster -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B3271C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="EditorTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="10,4,4,4" Margin="0,0,2,-1" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titelbalk met tabkoppen en vensterknoppen, het geselecteerde knipsel eronder; het actieve tabblad loopt door in de werkbalk -->
        <Style x:Key="EditorTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource WindowBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Height="32">
                                        <Button Style="{StaticResource CaptionButton}" ToolTip="Minimaliseren"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                            <TextBlock Text="&#xE921;" Style="{StaticResource CaptionGlyph}" />
                                        </Button>
                                        <Button Command="{x:Static editor:EditorShellWindow.ToggleMaximizeCommand}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionGlyph}">
                                                        <Setter Property="Text" Value="&#xE922;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                                <Setter Property="Text" Value="&#xE923;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                                    <Setter Property="ToolTip" Value="Maximaliseren" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                            <Setter Property="ToolTip" Value="Vorige grootte" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource CaptionCloseButton}" ToolTip="Sluiten"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}">
                                            <TextBlock Text="&#xE8BB;" Style="{StaticResource CaptionGlyph}" />
                                        </Button>
                                    </StackPanel>
                                    <Image DockPanel.Dock="Left" Source="pack://application:,,,/AppIcon.ico" Width="16" Height="16"
                                           Margin="12,6,4,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="AppIcon_MouseLeftButtonDown" />
                                    <!-- Rechts van de tabkoppen blijft altijd een stuk balk over om het venster te verslepen -->
                                    <editor:TabStripPanel IsItemsHost="True" Margin="6,6,48,0" HorizontalAlignment="Left"
                                                          KeyboardNavigation.TabIndex="1" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Style="{StaticResource EditorTabs}" SelectionChanged="Tabs_SelectionChanged" />
</Window>
