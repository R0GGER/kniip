<UserControl x:Class="Kniip.Editor.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Kniip.Resources"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#E4E4E4" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource FlatButton}" Padding="6,4" MinWidth="0" MinHeight="30"
                      BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource ControlBrush}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="20" Height="20">
                    <Border x:Name="CheckerBack" CornerRadius="4" Background="{StaticResource Checker}" Visibility="Collapsed" />
                    <Border x:Name="Swatch" CornerRadius="4" BorderThickness="0" />
                    <Border x:Name="OutlineHole" CornerRadius="1.5" Margin="5" Background="{DynamicResource ControlBrush}" Visibility="Collapsed" />
                    <Grid x:Name="TextGlyph" Background="{DynamicResource ControlBrush}" Visibility="Collapsed">
                        <TextBlock Text="A" FontSize="14" HorizontalAlignment="Center" Margin="0,-1,0,0"
                                   Foreground="{DynamicResource InkBrush}" />
                        <Border x:Name="TextBar" Height="4" CornerRadius="1" VerticalAlignment="Bottom" Margin="2,0" />
                    </Grid>
                </Grid>
                <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Margin="5,0,1,0" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="PopupPanel" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlStrongBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <StackPanel>
                    <UniformGrid x:Name="SwatchGrid" Columns="7" />
                    <Button Style="{StaticResource FlatButton}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="MoreColors_Click">
                        <TextBlock Text="{x:Static res:Strings.Color_MoreColors}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
