<Window x:Class="Kniip.Editor.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Kniip.Resources"
        Title="{x:Static res:Strings.Ocr_Title}" Width="560" Height="420" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/AppIcon.ico">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{x:Static res:Strings.Common_Close}" IsCancel="True" Click="Close_Click" />
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" ToolTip="{x:Static res:Strings.Ocr_CopyTip}"
                    Click="Copy_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" Foreground="White" />
                    <TextBlock x:Name="CopyLabel" Text="{x:Static res:Strings.Common_Copy}" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </DockPanel>
        <Grid>
            <TextBox x:Name="ResultBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Padding="6"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Segoe UI" FontSize="13" SelectionChanged="ResultBox_SelectionChanged" />
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="&#xE8D2;" Style="{StaticResource IconText}" FontSize="28" Foreground="{DynamicResource SubtleTextBrush}" />
                <TextBlock x:Name="EmptyText" Text="{x:Static res:Strings.Ocr_NoText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="380" Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
