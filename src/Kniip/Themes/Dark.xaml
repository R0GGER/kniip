<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3183CA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#334CC2FF" />
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="UnlockedToolbarBrush" Color="#1F3347" />
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToastBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CheckedBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="InkBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="ControlBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="ProminentBrush" Color="#383838" />
    <SolidColorBrush x:Key="ProminentHoverBrush" Color="#424242" />
    <SolidColorBrush x:Key="ProminentPressedBrush" Color="#303030" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="CanvasBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="CodeBrush" Color="#333333" />
    <SolidColorBrush x:Key="QuoteBorderBrush" Color="#505050" />

    <!-- Standaardbesturingselementen van WPF lezen deze systeemkleuren -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8A8A8A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#4CC2FF" />

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#5C5C5C" CornerRadius="3" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7A7A7A" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8E8E8E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="#F2F2F2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#333333" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
